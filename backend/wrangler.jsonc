{
  "name": "shotledger-backend",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-25",
  "observability": {
    "enabled": true,
  },
  // The read-only web app (ADR 0013), served same-origin so sign-in needs no
  // CORS. Build it first: `pnpm --filter @shotledger/web build`. The Worker
  // answers its own routes; everything else falls back to the app's page.
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/sync/*", "/photos/*", "/account/*"],
  },
  // Local/test-only for this task — never deployed (no real database_id).
  // See docs/specs/sync-protocol-spec.md §5.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shotledger-sync-dev",
      "database_id": "local-dev-placeholder",
      "migrations_dir": "migrations",
    },
  ],
  // Local/test-only placeholder — never deployed (no real bucket_name).
  // See docs/specs/backend-auth-photos-spec.md §5.
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "shotledger-photos-dev",
    },
  ],
  // Dev/test-only placeholder value — production secret is provisioned via
  // `wrangler secret put BETTER_AUTH_SECRET` by the maintainer, never
  // committed here (docs/specs/backend-auth-photos-spec.md §2).
  "vars": {
    "BETTER_AUTH_SECRET": "dev-placeholder-secret-never-use-in-production",
  },
}
