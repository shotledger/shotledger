// The top level is local development and the vitest pool only. `staging` and
// `production` are deployed with `--env` (`pnpm deploy:staging`,
// `pnpm deploy:production`, docs/release.md). Wrangler does not inherit
// `vars`, `d1_databases` or `r2_buckets` into a named env. There is no
// secret here: locally `createAuth` uses its dev placeholder, and a deployed
// env refuses to start without a real one.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "shotledger-backend",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-25",
  "observability": {
    "enabled": true,
  },
  // The read-only web app (ADR 0013), served same-origin so sign-in needs no
  // CORS. Build it first: `pnpm --filter @shotledger/web build`. The Worker
  // answers its own routes; everything else falls back to the app's page.
  // Its security headers are in web/public/_headers.
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/sync/*", "/photos/*", "/account/*"],
  },
  // Local/test-only — never deployed (no real database_id).
  // See docs/specs/sync-protocol-spec.md §5.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shotledger-sync-dev",
      "database_id": "local-dev-placeholder",
      "migrations_dir": "migrations",
    },
  ],
  // Local/test-only placeholder — never deployed (no real bucket_name).
  // See docs/specs/backend-auth-photos-spec.md §5.
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "shotledger-photos-dev",
    },
  ],
  "vars": {
    "ENVIRONMENT": "development",
  },
  // TODO(maintainer): create each env's resources and replace every
  // REPLACE_ME below; a deploy with a placeholder fails. The hostnames are
  // the maintainer's decision, so the routes stay commented out until then.
  "env": {
    "staging": {
      // "routes": [{ "pattern": "REPLACE_ME", "custom_domain": true }],
      // Only the custom domain serves it: no *.workers.dev or preview URLs.
      "workers_dev": false,
      "preview_urls": false,
      // Purges stale better-auth rate-limit rows (scheduled() in src/index.ts).
      "triggers": { "crons": ["*/15 * * * *"] },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "shotledger-sync-staging",
          "database_id": "REPLACE_ME-staging-d1-id",
          "migrations_dir": "migrations",
        },
      ],
      "r2_buckets": [
        {
          "binding": "PHOTOS",
          "bucket_name": "shotledger-photos-staging",
        },
      ],
      "vars": {
        "ENVIRONMENT": "staging",
        "BETTER_AUTH_URL": "https://REPLACE_ME.invalid",
        "BETTER_AUTH_TRUSTED_ORIGINS": "shotledger://",
      },
      "secrets": {
        "required": ["BETTER_AUTH_SECRET"],
      },
    },
    "production": {
      // "routes": [{ "pattern": "REPLACE_ME", "custom_domain": true }],
      // Only the custom domain serves it: no *.workers.dev or preview URLs.
      "workers_dev": false,
      "preview_urls": false,
      // Purges stale better-auth rate-limit rows (scheduled() in src/index.ts).
      "triggers": { "crons": ["*/15 * * * *"] },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "shotledger-sync",
          "database_id": "REPLACE_ME-production-d1-id",
          "migrations_dir": "migrations",
        },
      ],
      "r2_buckets": [
        {
          "binding": "PHOTOS",
          "bucket_name": "shotledger-photos",
        },
      ],
      "vars": {
        "ENVIRONMENT": "production",
        "BETTER_AUTH_URL": "https://REPLACE_ME.invalid",
        "BETTER_AUTH_TRUSTED_ORIGINS": "shotledger://",
      },
      "secrets": {
        "required": ["BETTER_AUTH_SECRET"],
      },
    },
  },
}
