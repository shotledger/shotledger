{
  "name": "@shotledger/backend",
  "version": "0.0.0",
  "private": true,
  "license": "Elastic-2.0",
  "scripts": {
    "deploy:staging": "pnpm --filter @shotledger/web build && wrangler deploy --env staging",
    "deploy:production": "pnpm --filter @shotledger/web build && wrangler deploy --env production",
    "db:migrate:staging": "wrangler d1 migrations apply DB --remote --env staging",
    "db:migrate:production": "wrangler d1 migrations apply DB --remote --env production",
    "dev": "wrangler dev",
    "start": "wrangler dev",
    "test": "vitest run",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.7",
    "@shotledger/shared": "workspace:*",
    "better-auth": "1.7.7",
    "drizzle-orm": "0.45.3",
    "hono": "4.13.13"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.3.6",
    "@cloudflare/workers-types": "5.20261005.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "4.1.11",
    "wrangler": "4.147.0"
  }
}
