{
  "name": "shotledger",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": "24.22.1"
  },
  "scripts": {
    "typecheck": "tsc -b && tsc -p backend/test/tsconfig.json",
    "typecheck:app": "node scripts/ensure-expo-env.mjs && cd app && pnpm exec tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --check --cache --cache-strategy content .",
    "i18n:check": "node scripts/i18n-check.mjs",
    "node:check": "node scripts/node-version-check.mjs",
    "cloudflare:setup": "node scripts/cloudflare-setup.mjs",
    "licenses:generate": "node scripts/generate-licenses.mjs",
    "licenses:check": "node scripts/generate-licenses.mjs --check",
    "check": "pnpm node:check && pnpm typecheck && pnpm typecheck:app && pnpm typecheck:web && pnpm schema:check && pnpm i18n:check && pnpm licenses:check && pnpm lint && pnpm format && vitest run --coverage && (cd app && pnpm exec jest --passWithNoTests --coverage)",
    "coverage": "vitest run --coverage",
    "mutation": "stryker run",
    "mutation:schema": "node scripts/mutate-schema.mjs",
    "mutation:webshooter-schema": "node scripts/mutate-webshooter-schema.mjs",
    "gauntlet": "pnpm typecheck && pnpm lint && pnpm format && pnpm coverage && (cd app && pnpm exec jest --passWithNoTests --coverage) && pnpm mutation && pnpm mutation:schema && pnpm mutation:webshooter-schema",
    "schema:generate": "node scripts/generate-export-schema.mjs",
    "schema:check": "node scripts/generate-export-schema.mjs --check",
    "cv:regression": "vitest run -c tools/cv/vitest.config.ts regression.check",
    "cv:fixtures": "CV_FIXTURES=1 vitest run --silent=false -c tools/cv/vitest.config.ts fixtures.tool",
    "docs:translations": "node scripts/docs-translation-check.mjs",
    "docs:anchors": "node scripts/docs-anchor-check.mjs",
    "reqstool:tags": "reqstool-typescript-tags tags --inputs shared/src,backend/src,app/src --output build/reqstool/annotations.yml",
    "reqstool:status": "reqstool status --check-all-reqs-met local -p docs/reqstool",
    "typecheck:web": "tsc --noEmit -p web/tsconfig.json"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@reqstool/reqstool-typescript-tags": "0.3.0",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@techstark/opencv-js": "4.12.0-release.1",
    "@types/node": "26.6.5",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-native": "5.0.0",
    "fast-check": "4.10.2",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
