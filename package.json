{
  "name": "shotledger",
  "private": true,
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": "26.8.2"
  },
  "scripts": {
    "typecheck": "tsc -b",
    "typecheck:app": "node scripts/ensure-expo-env.mjs && cd app && pnpm exec tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --check .",
    "i18n:check": "node scripts/i18n-check.mjs",
    "licenses:generate": "node scripts/generate-licenses.mjs",
    "licenses:check": "node scripts/generate-licenses.mjs --check",
    "check": "pnpm typecheck && pnpm typecheck:app && pnpm schema:check && pnpm i18n:check && pnpm licenses:check && pnpm lint && pnpm format && vitest run && (cd app && pnpm exec jest --passWithNoTests)",
    "coverage": "vitest run --coverage",
    "mutation": "stryker run",
    "mutation:schema": "node scripts/mutate-schema.mjs",
    "mutation:webshooter-schema": "node scripts/mutate-webshooter-schema.mjs",
    "gauntlet": "pnpm typecheck && pnpm lint && pnpm format && pnpm coverage && (cd app && pnpm exec jest --passWithNoTests) && pnpm mutation && pnpm mutation:schema && pnpm mutation:webshooter-schema",
    "schema:generate": "node scripts/generate-export-schema.mjs",
    "schema:check": "node scripts/generate-export-schema.mjs --check",
    "docs:translations": "node scripts/docs-translation-check.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@types/node": "26.6.1",
    "@vitest/coverage-v8": "5.0.1",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-native": "5.0.0",
    "fast-check": "4.10.1",
    "globals": "17.12.0",
    "prettier": "3.9.6",
    "@typescript/native": "npm:typescript@7.0.2",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.1"
  }
}
