{
  "name": "shotledger",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --check .",
    "check": "pnpm typecheck && pnpm lint && vitest run && (cd app && pnpm exec jest --passWithNoTests)",
    "coverage": "vitest run --coverage",
    "mutation": "stryker run",
    "mutation:schema": "node scripts/mutate-schema.mjs",
    "mutation:webshooter-schema": "node scripts/mutate-webshooter-schema.mjs",
    "gauntlet": "pnpm typecheck && pnpm lint && pnpm format && pnpm coverage && (cd app && pnpm exec jest --passWithNoTests) && pnpm mutation && pnpm mutation:schema && pnpm mutation:webshooter-schema"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-native": "^5.0.0",
    "fast-check": "^4.9.0",
    "globals": "^17.12.0",
    "prettier": "^3.6.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^3.2.4"
  }
}
