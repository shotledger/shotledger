{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jimisola.github.io/shotledger/reference/sessions-export.schema.json",
  "$comment": "Generated from shared/src/json-export/types.ts by scripts/generate-export-schema.mjs. Do not hand-edit: `pnpm schema:check` fails when this file and that source disagree.",
  "title": "ShotLedger sessions export",
  "description": "The file produced by Settings → Export Sessions. `format` is always \"shotledger.sessions\". An importer must refuse a higher `formatVersion` rather than dropping fields it does not understand. This URL always describes the CURRENT format version, today 1; pin https://jimisola.github.io/shotledger/reference/v1/sessions-export.schema.json instead if you need it to stay put.",
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "const": "shotledger.sessions",
      "description": "Identifies the file. Always `shotledger.sessions`."
    },
    "formatVersion": {
      "type": "integer",
      "description": "Bumped only for a breaking change. An importer must refuse a higher version rather than dropping fields it does not understand.",
      "const": 1
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
      "description": "When the file was written, ISO 8601."
    },
    "app": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "The application that wrote the file."
        },
        "version": {
          "type": "string",
          "description": "That application's version."
        }
      },
      "required": [
        "name",
        "version"
      ],
      "additionalProperties": false,
      "description": "What wrote the file — for support, never for import decisions."
    },
    "sessions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "Stable id of the session. An import matches on this to update rather than duplicate."
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "The session's display name."
          },
          "type": {
            "type": "string",
            "enum": [
              "training",
              "competition"
            ],
            "description": "Whether the session was training or a competition."
          },
          "kind": {
            "default": "series",
            "description": "What the session records: `series` logs scored series, `rounds` only a number of rounds fired, held in `extraRounds`, and never has series.",
            "type": "string",
            "enum": [
              "series",
              "rounds"
            ]
          },
          "disciplineId": {
            "type": "string",
            "minLength": 1,
            "description": "Discipline id, e.g. `spsf-precision`. Free text: an import may name one this build does not define."
          },
          "programId": {
            "description": "Shot-program id within the discipline, or null for no fixed format.",
            "type": [
              "string",
              "null"
            ]
          },
          "competitionLevel": {
            "description": "Competition level (forening, krets, landsdel, national, riks), or null for training.",
            "type": [
              "string",
              "null"
            ]
          },
          "isChampionship": {
            "type": "boolean",
            "description": "Whether the competition was a mästerskap — KM, DM, SM. A flag on the level, not a level of its own."
          },
          "competitionName": {
            "description": "The event's own name, if it had one.",
            "type": [
              "string",
              "null"
            ]
          },
          "weaponGroup": {
            "description": "Federation-scoped vapengrupp id, e.g. `spsf:C`. A training session takes this from its firearm rather than being asked; null when it could not be determined.",
            "type": [
              "string",
              "null"
            ]
          },
          "shooterClass": {
            "description": "Klass the shooter entered under, e.g. `2` or `VetY`. Null on a training session — klass is a competition entry attribute.",
            "type": [
              "string",
              "null"
            ]
          },
          "eventId": {
            "default": null,
            "description": "ISSF event id, `<disciplineId>:<gender>:<age>`. Null for a discipline whose category rides on the klass instead, and for training sessions.",
            "type": [
              "string",
              "null"
            ]
          },
          "firearmId": {
            "default": null,
            "description": "Id of an entry in the envelope's `firearms`, or null.",
            "type": [
              "string",
              "null"
            ]
          },
          "firearm": {
            "description": "`\"{make} {model}\"`, or null if the session has no firearm. The fallback when `firearmId` names no firearm the file carries.",
            "type": [
              "string",
              "null"
            ]
          },
          "ammoLot": {
            "description": "The ammunition lot's label, or null.",
            "type": [
              "string",
              "null"
            ]
          },
          "startedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
            "description": "When the session started, ISO 8601."
          },
          "location": {
            "description": "Where it was shot, as free text.",
            "type": [
              "string",
              "null"
            ]
          },
          "notes": {
            "description": "The session's notes.",
            "type": [
              "string",
              "null"
            ]
          },
          "tenCount": {
            "default": null,
            "description": "Tens recorded for the session itself. Set only where there are no shots to count them from (a ShotLog import); null otherwise.",
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "innerTenCount": {
            "default": null,
            "description": "Inner tens (X) recorded for the session itself, on the same terms as `tenCount`.",
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "decimalScoring": {
            "type": "boolean",
            "description": "Whether scores are decimal. Affects how `valueTenths` reads, never what it stores."
          },
          "seriesLength": {
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ],
            "description": "Shots per series chosen when the session was created. Null when a fixed format sets it instead, and on a session not scored in ring series."
          },
          "extraRounds": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ],
            "description": "Rounds fired but never scored — the whole shot count of a rounds-only session."
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The session's tags."
          },
          "series": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "position": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991,
                  "description": "1-based position of the series within its session."
                },
                "isSighter": {
                  "type": "boolean",
                  "description": "A sighter (provserie) is shot but not counted towards the session total."
                },
                "isFinal": {
                  "type": "boolean",
                  "description": "Whether the series belongs to a championship final."
                },
                "isShootOff": {
                  "default": false,
                  "description": "A särskjutning series, shot to decide a placement. Scored like any other series.",
                  "type": "boolean"
                },
                "shots": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "position": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 9007199254740991,
                        "description": "1-based position of the shot within its series."
                      },
                      "valueTenths": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 109,
                        "description": "Score in tenths of a point, so a decimal 10.9 is 109 and a whole 9 is 90. A miss is 0."
                      },
                      "isInnerTen": {
                        "type": "boolean",
                        "description": "Whether the shot counts as an inner ten (X), used for tie-breaks."
                      }
                    },
                    "required": [
                      "position",
                      "valueTenths",
                      "isInnerTen"
                    ],
                    "additionalProperties": false
                  },
                  "description": "The shots of this series, in the order they were entered."
                },
                "totalOverride": {
                  "default": null,
                  "description": "A series known only by its total, as WebShooter and ShotLog report results. Null on a series scored shot by shot.",
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "tenths": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991,
                          "description": "The series total in tenths of a point, as the source reported it."
                        },
                        "shotCount": {
                          "anyOf": [
                            {
                              "type": "integer",
                              "exclusiveMinimum": 0,
                              "maximum": 9007199254740991
                            },
                            {
                              "type": "null"
                            }
                          ],
                          "description": "Shots behind that total, or null when the source gave none; the discipline's series length then stands in."
                        }
                      },
                      "required": [
                        "tenths",
                        "shotCount"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "position",
                "isSighter",
                "isFinal",
                "isShootOff",
                "shots",
                "totalOverride"
              ],
              "additionalProperties": false
            },
            "description": "The series of this session, in order."
          },
          "faltResultMode": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "falt",
                  "poangfalt"
                ]
              },
              {
                "type": "null"
              }
            ],
            "description": "How a fältskjutning round is reported — hits and figures, or the poängfält sum. Null on any other discipline."
          },
          "stations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "position": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991,
                  "description": "1-based station number within the round."
                },
                "hits": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 6,
                  "description": "Hits at the station, 0-6 (six shots)."
                },
                "figuresHit": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 6,
                  "description": "Figures hit at least once. Never more than `hits`."
                },
                "figureCount": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 6
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "Figures set out at the station, or null when not recorded."
                },
                "points": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "Poängmål points scored, or null when the station had no ringed figure."
                },
                "pointsMax": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "What that poängmål could give — the organizer picks the scheme."
                },
                "isScratched": {
                  "type": "boolean",
                  "description": "An annulled station: kept and shown, never scored. Its rounds still count."
                },
                "isShootOff": {
                  "type": "boolean",
                  "description": "A särskjutning station: decides placement only, never enters the score."
                },
                "note": {
                  "description": "The station's note.",
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "position",
                "hits",
                "figuresHit",
                "figureCount",
                "points",
                "pointsMax",
                "isScratched",
                "isShootOff",
                "note"
              ],
              "additionalProperties": false
            },
            "description": "The fält stations of this session, in order. Empty on any other discipline."
          },
          "externalSource": {
            "default": null,
            "description": "Where an imported session came from, e.g. `webshooter` or `shotlog`. Null on a session logged in the app.",
            "type": [
              "string",
              "null"
            ]
          },
          "externalRef": {
            "default": null,
            "description": "The source's own key for the session, without a source prefix (`363:35937` from Webshooter, the Session ID `S-0a1b2c3d` from ShotLog). A later import from the same `externalSource` matches on it to update the session rather than add a second one.",
            "type": [
              "string",
              "null"
            ]
          },
          "officialPlacement": {
            "default": null,
            "description": "Placement in the official results, as the organizer published it, or null.",
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "officialStandardMedal": {
            "default": null,
            "description": "Standardmedalj in the official results, or null when none was published. Separate from the medal the app computes itself.",
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "none",
                  "brons",
                  "silver",
                  "guld"
                ]
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "name",
          "type",
          "kind",
          "disciplineId",
          "programId",
          "competitionLevel",
          "isChampionship",
          "competitionName",
          "weaponGroup",
          "shooterClass",
          "eventId",
          "firearmId",
          "firearm",
          "ammoLot",
          "startedAt",
          "location",
          "notes",
          "tenCount",
          "innerTenCount",
          "decimalScoring",
          "seriesLength",
          "extraRounds",
          "tags",
          "series",
          "faltResultMode",
          "stations",
          "externalSource",
          "externalRef",
          "officialPlacement",
          "officialStandardMedal"
        ],
        "additionalProperties": false,
        "title": "Session"
      },
      "description": "The exported sessions. Typed loosely by the parser on purpose, so one bad session is rejected on its own rather than failing the whole file; the real shape is documented here."
    },
    "firearms": {
      "default": [],
      "description": "The firearms the sessions reference, so a file can be imported into an empty install without retyping the equipment. Loosely typed by the parser for the same reason as `sessions`.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "Stable id of the firearm. A session references it as `firearmId`."
          },
          "make": {
            "type": "string",
            "minLength": 1,
            "description": "Manufacturer, e.g. `Pardini`."
          },
          "model": {
            "type": "string",
            "description": "Model, e.g. `SP`. May be empty when only a make is known."
          },
          "caliber": {
            "description": "Caliber, e.g. `.22 LR`. One per firearm today.",
            "type": [
              "string",
              "null"
            ]
          },
          "weaponType": {
            "default": null,
            "description": "Vapentyp, or null when unstated.",
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "pistol",
                  "revolver",
                  "rifle",
                  "airgun"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "isOwn": {
            "default": true,
            "description": "Whether the shooter owns it, as opposed to a borrowed or club firearm.",
            "type": "boolean"
          },
          "serialNumber": {
            "default": null,
            "description": "Serial number, or null.",
            "type": [
              "string",
              "null"
            ]
          },
          "vapenId": {
            "default": null,
            "description": "National register id (`SE…` on the back of a Swedish license card), or null.",
            "type": [
              "string",
              "null"
            ]
          },
          "loadSystem": {
            "default": null,
            "description": "Laddsystem, e.g. `halvautomat`.",
            "type": [
              "string",
              "null"
            ]
          },
          "notes": {
            "default": null,
            "description": "The firearm's notes.",
            "type": [
              "string",
              "null"
            ]
          },
          "roundCount": {
            "default": 0,
            "description": "Rounds fired through it in total.",
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "maintenanceIntervalRounds": {
            "default": null,
            "description": "Rounds between cleanings, or null for no reminder.",
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "roundsSinceMaintenance": {
            "default": 0,
            "description": "Rounds fired since the last maintenance event.",
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "id",
          "make",
          "model",
          "caliber",
          "weaponType",
          "isOwn",
          "serialNumber",
          "vapenId",
          "loadSystem",
          "notes",
          "roundCount",
          "maintenanceIntervalRounds",
          "roundsSinceMaintenance"
        ],
        "additionalProperties": false,
        "title": "Firearm"
      }
    },
    "licenses": {
      "default": [],
      "description": "Weapon licenses, one entry per issued license, each naming its firearm. Loosely typed by the parser for the same reason as `sessions`.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "Stable id of the license row."
          },
          "firearmId": {
            "type": "string",
            "minLength": 1,
            "description": "The firearm this license is for. An import drops a license naming no firearm."
          },
          "licenseNumber": {
            "default": null,
            "description": "License number, e.g. `A123.456`.",
            "type": [
              "string",
              "null"
            ]
          },
          "purpose": {
            "default": null,
            "description": "Ändamål, e.g. `Målskjutning`.",
            "type": [
              "string",
              "null"
            ]
          },
          "decidedOn": {
            "default": null,
            "description": "Date of decision, `YYYY-MM-DD`.",
            "type": [
              "string",
              "null"
            ]
          },
          "validUntil": {
            "default": null,
            "description": "Valid through, `YYYY-MM-DD`; null means tills vidare (no expiry).",
            "type": [
              "string",
              "null"
            ]
          },
          "conditions": {
            "default": null,
            "description": "Villkor, often empty.",
            "type": [
              "string",
              "null"
            ]
          },
          "authority": {
            "default": null,
            "description": "Issuing authority.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "firearmId",
          "licenseNumber",
          "purpose",
          "decidedOn",
          "validUntil",
          "conditions",
          "authority"
        ],
        "additionalProperties": false,
        "title": "License"
      }
    }
  },
  "required": [
    "format",
    "formatVersion",
    "generatedAt",
    "app",
    "sessions",
    "firearms",
    "licenses"
  ],
  "additionalProperties": false,
  "examples": [
    {
      "format": "shotledger.sessions",
      "formatVersion": 1,
      "generatedAt": "2026-09-13T09:41:00.000Z",
      "app": {
        "name": "ShotLedger",
        "version": "0.1.0"
      },
      "sessions": [
        {
          "id": "ses_7Qn2",
          "name": "Precision — 13 Sep 2026",
          "type": "training",
          "disciplineId": "spsf-precision",
          "programId": null,
          "competitionLevel": null,
          "isChampionship": false,
          "competitionName": null,
          "weaponGroup": "spsf:C",
          "shooterClass": null,
          "eventId": null,
          "firearmId": "arm_4Kd9",
          "firearm": "Pardini SP",
          "ammoLot": null,
          "startedAt": "2026-09-13T08:00:00.000Z",
          "location": "Klubbanan",
          "notes": null,
          "decimalScoring": false,
          "extraRounds": null,
          "tags": [
            "träning"
          ],
          "series": [
            {
              "position": 1,
              "isSighter": true,
              "isFinal": false,
              "shots": [
                {
                  "position": 1,
                  "valueTenths": 90,
                  "isInnerTen": false
                }
              ]
            }
          ]
        }
      ],
      "firearms": [
        {
          "id": "arm_4Kd9",
          "make": "Pardini",
          "model": "SP",
          "caliber": ".22 LR",
          "weaponType": "pistol",
          "isOwn": true,
          "serialNumber": null,
          "vapenId": null,
          "loadSystem": null,
          "notes": null,
          "roundCount": 1200,
          "maintenanceIntervalRounds": 500,
          "roundsSinceMaintenance": 120
        }
      ],
      "licenses": [
        {
          "id": "lic_2Bf1",
          "firearmId": "arm_4Kd9",
          "licenseNumber": "A123.456/2026-01",
          "purpose": "Målskjutning",
          "decidedOn": "2026-01-15",
          "validUntil": null,
          "conditions": null,
          "authority": "Polismyndigheten"
        }
      ]
    }
  ]
}
