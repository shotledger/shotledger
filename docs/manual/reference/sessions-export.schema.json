{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jimisola.github.io/shotledger/reference/sessions-export.schema.json",
  "title": "ShotLedger sessions export",
  "description": "The file produced by Settings → Export Sessions. `format` is always \"shotledger.sessions\" and the current `formatVersion` is 1. An importer must refuse a higher formatVersion rather than dropping fields it does not understand.",
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "const": "shotledger.sessions"
    },
    "formatVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "generatedAt": {
      "type": "string"
    },
    "app": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "additionalProperties": false
    },
    "sessions": {
      "type": "array",
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "enum": [
              "training",
              "competition"
            ]
          },
          "disciplineId": {
            "type": "string",
            "minLength": 1
          },
          "programId": {
            "type": [
              "string",
              "null"
            ]
          },
          "competitionLevel": {
            "type": [
              "string",
              "null"
            ]
          },
          "isChampionship": {
            "type": "boolean"
          },
          "competitionName": {
            "type": [
              "string",
              "null"
            ]
          },
          "weaponGroup": {
            "type": [
              "string",
              "null"
            ]
          },
          "shooterClass": {
            "type": [
              "string",
              "null"
            ]
          },
          "eventId": {
            "default": null,
            "type": [
              "string",
              "null"
            ]
          },
          "firearm": {
            "type": [
              "string",
              "null"
            ]
          },
          "ammoLot": {
            "type": [
              "string",
              "null"
            ]
          },
          "startedAt": {
            "type": "string",
            "minLength": 1
          },
          "location": {
            "type": [
              "string",
              "null"
            ]
          },
          "notes": {
            "type": [
              "string",
              "null"
            ]
          },
          "decimalScoring": {
            "type": "boolean"
          },
          "extraRounds": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "series": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "position": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "isSighter": {
                  "type": "boolean"
                },
                "isFinal": {
                  "type": "boolean"
                },
                "shots": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "position": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 9007199254740991
                      },
                      "valueTenths": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 109
                      },
                      "isInnerTen": {
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "position",
                      "valueTenths",
                      "isInnerTen"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "position",
                "isSighter",
                "isFinal",
                "shots"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "name",
          "type",
          "disciplineId",
          "programId",
          "competitionLevel",
          "isChampionship",
          "competitionName",
          "weaponGroup",
          "shooterClass",
          "eventId",
          "firearm",
          "ammoLot",
          "startedAt",
          "location",
          "notes",
          "decimalScoring",
          "extraRounds",
          "tags",
          "series"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "format",
    "formatVersion",
    "generatedAt",
    "app",
    "sessions"
  ],
  "additionalProperties": false
}
