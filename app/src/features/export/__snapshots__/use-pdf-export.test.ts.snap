// Jest Snapshot v1, https://jestjs.io/docs/snapshot-testing

exports[`buildShootingLogHtmlForFilters narrows to one firearm and an open-ended period, in Swedish 1`] = `
"<!doctype html>
<html>
<head>
<meta charset="utf-8">
<style>
  body { font-family: -apple-system, Roboto, Helvetica, Arial, sans-serif; padding: 24px; color: #111; }
  h1 { font-size: 20px; margin-bottom: 4px; }
  .summary { font-size: 12px; color: #444; margin-bottom: 16px; }
  .summary div { margin-bottom: 2px; }
  table { width: 100%; border-collapse: collapse; font-size: 11px; }
  th, td { border: 1px solid #333; padding: 6px; text-align: left; vertical-align: top; }
  th { background: #f2f2f2; }
  /* Ruled and empty: signed by hand, never by the app. */
  td.sign { min-width: 28%; height: 22px; }
  .note { font-size: 10px; color: #444; margin-top: 8px; }
  .empty { font-style: italic; color: #666; }
</style>
</head>
<body>
  <h1>Skjutlogg (föreningsintyg)</h1>
  <div class="summary">
    <div>Personlig skyttelogg för: ______________________________</div>
    <div>Personnummer: ______________________________</div>
    <div>Alla – idag</div>
    <div>Pardini SP</div>
    <div>Pass: 2 · Skott: 80</div>
    <div>Genererad 1 juni 2026</div>
  </div>
  <table>
    <thead>
      <tr><th>Datum</th><th>Plats</th><th>Skytteaktivitet</th><th>Använt vapen</th><th>Uppg. styrkta av</th></tr>
    </thead>
    <tbody>
        <tr>
          <td>20 maj 2026</td>
          <td>Club range</td>
          <td>KM Milsnabb · Militär snabbmatch · 2</td>
          <td>Pardini SP</td>
          <td class="sign"></td>
        </tr>
        <tr>
          <td>15 jan. 2026</td>
          <td>Ej angiven</td>
          <td>Träning · Precision</td>
          <td>Pardini SP</td>
          <td class="sign"></td>
        </tr></tbody>
  </table>
  <p class="note">Kolumnen ”Uppg. styrkta av” lämnas tom med flit: i en föreningslogg räknas en rad som bevis först när någon skrivit under den, och det kan bara en människa göra.</p>
</body>
</html>"
`;

exports[`buildShootingLogHtmlForFilters prints every session in the period, in English 1`] = `
"<!doctype html>
<html>
<head>
<meta charset="utf-8">
<style>
  body { font-family: -apple-system, Roboto, Helvetica, Arial, sans-serif; padding: 24px; color: #111; }
  h1 { font-size: 20px; margin-bottom: 4px; }
  .summary { font-size: 12px; color: #444; margin-bottom: 16px; }
  .summary div { margin-bottom: 2px; }
  table { width: 100%; border-collapse: collapse; font-size: 11px; }
  th, td { border: 1px solid #333; padding: 6px; text-align: left; vertical-align: top; }
  th { background: #f2f2f2; }
  /* Ruled and empty: signed by hand, never by the app. */
  td.sign { min-width: 28%; height: 22px; }
  .note { font-size: 10px; color: #444; margin-top: 8px; }
  .empty { font-style: italic; color: #666; }
</style>
</head>
<body>
  <h1>Shooting Log (föreningsintyg)</h1>
  <div class="summary">
    <div>Personal shooting log for: ______________________________</div>
    <div>Personal ID number: ______________________________</div>
    <div>Jan 1, 2026 – May 31, 2026</div>
    
    <div>Sessions: 4 · Shots: 160</div>
    <div>Generated Jun 1, 2026</div>
  </div>
  <table>
    <thead>
      <tr><th>Date</th><th>Location</th><th>Shooting activity</th><th>Firearm used</th><th>Attested by</th></tr>
    </thead>
    <tbody>
        <tr>
          <td>May 20, 2026</td>
          <td>Club range</td>
          <td>KM Milsnabb · Military Rapid Fire · 2</td>
          <td>Pardini SP</td>
          <td class="sign"></td>
        </tr>
        <tr>
          <td>Apr 11, 2026</td>
          <td>Not recorded</td>
          <td>Training · Precision</td>
          <td>Not recorded</td>
          <td class="sign"></td>
        </tr>
        <tr>
          <td>Mar 2, 2026</td>
          <td>Forest &lt;range&gt; &amp; &quot;hall&quot;</td>
          <td>Competition · Fältskjutning</td>
          <td>Not recorded</td>
          <td class="sign"></td>
        </tr>
        <tr>
          <td>Jan 15, 2026</td>
          <td>Not recorded</td>
          <td>Training · Precision</td>
          <td>Pardini SP</td>
          <td class="sign"></td>
        </tr></tbody>
  </table>
  <p class="note">The “Attested by” column is left blank on purpose: on a club log a row counts as evidence once someone has signed it, and only a person can do that.</p>
</body>
</html>"
`;

