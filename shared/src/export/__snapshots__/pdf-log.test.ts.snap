// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`buildShootingLogHtml > matches the snapshot with a firearm filter 1`] = `
"<!doctype html>
<html>
<head>
<meta charset="utf-8">
<style>
  body { font-family: -apple-system, Roboto, Helvetica, Arial, sans-serif; padding: 24px; color: #111; }
  h1 { font-size: 20px; margin-bottom: 4px; }
  .summary { font-size: 12px; color: #444; margin-bottom: 16px; }
  .summary div { margin-bottom: 2px; }
  table { width: 100%; border-collapse: collapse; font-size: 11px; }
  th, td { border: 1px solid #ccc; padding: 4px 6px; text-align: left; }
  th { background: #f2f2f2; }
  .empty { font-style: italic; color: #666; }
</style>
</head>
<body>
  <h1>Shooting log</h1>
  <div class="summary">
    <div>2026-03-01 – 2026-09-01</div>
    <div>AW93 .22 LR</div>
    <div>2 · 20</div>
    <div>Generated 2026-09-01</div>
  </div>
  <table>
    <thead>
      <tr><th>Date</th><th>Discipline</th><th>Type</th><th>Series</th><th>Score</th><th>Location</th></tr>
    </thead>
    <tbody>
        <tr>
          <td>2026-08-01</td>
          <td>Precision</td>
          <td>Training</td>
          <td>6</td>
          <td>270</td>
          <td>Malmö Skyttegille</td>
        </tr>
        <tr>
          <td>2026-08-15</td>
          <td>Precision</td>
          <td>Competition</td>
          <td>10</td>
          <td>460</td>
          <td>Malmö Skyttegille</td>
        </tr></tbody>
  </table>
</body>
</html>"
`;

