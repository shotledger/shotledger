// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`buildSessionReportHtml > matches the snapshot 1`] = `
"<!doctype html>
<html>
<head>
<meta charset="utf-8">
<style>
  @page { margin: 14mm; }
  body { font-family: -apple-system, Roboto, Helvetica, Arial, sans-serif; color: #111; margin: 0; }
  h1 { font-size: 20px; margin: 0 0 6px; }
  .fields { display: flex; flex-wrap: wrap; gap: 4px 18px; font-size: 12px; margin-bottom: 4px; }
  .label { color: #555; }
  .generated { font-size: 10px; color: #666; margin-bottom: 12px; }
  /* Three series across, like TargetScan's side-by-side session report. */
  .grid { display: flex; flex-wrap: wrap; gap: 10px; }
  .card { width: calc((100% - 20px) / 3); box-sizing: border-box; border: 1px solid #ccc; border-radius: 6px; padding: 8px; break-inside: avoid; page-break-inside: avoid; }
  .card-head { display: flex; align-items: center; gap: 6px; font-size: 12px; margin-bottom: 6px; }
  .series-title { font-weight: 600; }
  .tag { font-size: 9px; border: 1px solid #999; border-radius: 8px; padding: 0 5px; color: #444; }
  .total { margin-left: auto; font-weight: 700; font-size: 14px; }
  .face { text-align: center; }
  .face svg { width: 100%; height: auto; max-width: 200px; }
  .values { display: flex; flex-wrap: wrap; gap: 3px; margin: 6px 0 4px; }
  .value { font-size: 11px; font-weight: 600; border: 1px solid #bbb; border-radius: 3px; min-width: 18px; text-align: center; padding: 1px 2px; }
  .figures { width: 100%; border-collapse: collapse; font-size: 10px; }
  .figures td { padding: 1px 0; }
  .figures td:last-child { text-align: right; }
  .empty { font-style: italic; color: #666; }
</style>
</head>
<body>
  <h1>Precision training</h1>
  <div class="fields"><div class="field"><span class="label">Date</span> 3 Oct 2026</div><div class="field"><span class="label">Discipline</span> Precision</div><div class="field"><span class="label">Firearm</span> Make Model</div><div class="field"><span class="label">Total</span> 183</div></div>
  <div class="generated">Generated 3 Oct 2026</div>
  <div class="grid"><div class="card">
    <div class="card-head"><span class="series-title">Series 1</span><span class="total">94</span></div>
    <div class="face"><svg xmlns="http://www.w3.org/2000/svg" width="200" height="200" viewBox="-78.75 -78.75 157.5 157.5"><rect x="-78.75" y="-78.75" width="157.5" height="157.5" fill="#f4f0e8"/><circle cx="0" cy="0" r="100" fill="#1c1c1e"/><circle cx="0" cy="0" r="12.5" fill="none" stroke="#f2ede3" stroke-width="0.63"/><circle cx="0" cy="0" r="25" fill="none" stroke="#f2ede3" stroke-width="0.63"/><circle cx="0" cy="0" r="50" fill="none" stroke="#f2ede3" stroke-width="0.63"/><circle cx="0" cy="0" r="75" fill="none" stroke="#f2ede3" stroke-width="0.63"/><circle cx="0" cy="0" r="100" fill="none" stroke="#f2ede3" stroke-width="0.63"/><circle cx="0" cy="0" r="125" fill="none" stroke="#1c1c1e" stroke-width="0.63"/><circle cx="0" cy="0" r="150" fill="none" stroke="#1c1c1e" stroke-width="0.63"/><circle cx="0" cy="0" r="175" fill="none" stroke="#1c1c1e" stroke-width="0.63"/><circle cx="0" cy="0" r="200" fill="none" stroke="#1c1c1e" stroke-width="0.63"/><circle cx="0" cy="0" r="225" fill="none" stroke="#1c1c1e" stroke-width="0.63"/><circle cx="0" cy="0" r="250" fill="none" stroke="#1c1c1e" stroke-width="0.63"/><text x="-18.75" y="1.76" font-size="5.04" fill="#f2ede3" text-anchor="middle">10</text><text x="18.75" y="1.76" font-size="5.04" fill="#f2ede3" text-anchor="middle">10</text><text x="-37.5" y="1.76" font-size="5.04" fill="#f2ede3" text-anchor="middle">9</text><text x="37.5" y="1.76" font-size="5.04" fill="#f2ede3" text-anchor="middle">9</text><text x="-62.5" y="1.76" font-size="5.04" fill="#f2ede3" text-anchor="middle">8</text><text x="62.5" y="1.76" font-size="5.04" fill="#f2ede3" text-anchor="middle">8</text><text x="-87.5" y="1.76" font-size="5.04" fill="#f2ede3" text-anchor="middle">7</text><text x="87.5" y="1.76" font-size="5.04" fill="#f2ede3" text-anchor="middle">7</text><text x="-112.5" y="1.76" font-size="5.04" fill="#1c1c1e" text-anchor="middle">6</text><text x="112.5" y="1.76" font-size="5.04" fill="#1c1c1e" text-anchor="middle">6</text><text x="-137.5" y="1.76" font-size="5.04" fill="#1c1c1e" text-anchor="middle">5</text><text x="137.5" y="1.76" font-size="5.04" fill="#1c1c1e" text-anchor="middle">5</text><text x="-162.5" y="1.76" font-size="5.04" fill="#1c1c1e" text-anchor="middle">4</text><text x="162.5" y="1.76" font-size="5.04" fill="#1c1c1e" text-anchor="middle">4</text><text x="-187.5" y="1.76" font-size="5.04" fill="#1c1c1e" text-anchor="middle">3</text><text x="187.5" y="1.76" font-size="5.04" fill="#1c1c1e" text-anchor="middle">3</text><text x="-212.5" y="1.76" font-size="5.04" fill="#1c1c1e" text-anchor="middle">2</text><text x="212.5" y="1.76" font-size="5.04" fill="#1c1c1e" text-anchor="middle">2</text><text x="-237.5" y="1.76" font-size="5.04" fill="#1c1c1e" text-anchor="middle">1</text><text x="237.5" y="1.76" font-size="5.04" fill="#1c1c1e" text-anchor="middle">1</text><circle cx="5" cy="-3" r="4.83" fill="#2563eb" stroke="#93c5fd" stroke-width="1.21" opacity="0.85"/><circle cx="-12" cy="8" r="4.83" fill="#2563eb" stroke="#93c5fd" stroke-width="1.21" opacity="0.85"/><circle cx="20" cy="15" r="4.83" fill="#2563eb" stroke="#93c5fd" stroke-width="1.21" opacity="0.85"/><circle cx="4.33" cy="6.67" r="14.61" fill="none" stroke="#dc2626" stroke-width="0.79"/><line x1="1.97" y1="6.67" x2="6.7" y2="6.67" stroke="#dc2626" stroke-width="0.79"/><line x1="4.33" y1="4.3" x2="4.33" y2="9.03" stroke="#dc2626" stroke-width="0.79"/></svg></div>
    <div class="values"><span class="value">X</span><span class="value">10</span><span class="value">10</span><span class="value">9</span><span class="value">9</span></div>
    <table class="figures"><tr><td>Windage</td><td>4.3 mm</td></tr><tr><td>Elevation</td><td>-6.7 mm</td></tr><tr><td>Mean Radius</td><td>15.0 mm</td></tr><tr><td>Max Spread</td><td>33.3 mm</td></tr></table>
  </div><div class="card">
    <div class="card-head"><span class="series-title">Series 2</span><span class="tag">Sighter</span><span class="total">89</span></div>
    
    <div class="values"><span class="value">10</span><span class="value">9</span><span class="value">9</span><span class="value">8</span><span class="value">8</span></div>
    
  </div></div>
</body>
</html>"
