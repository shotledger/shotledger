# Android toolchain (installed outside the repo; see CLAUDE.md agentic loop)
export ANDROID_HOME="$HOME/Android/Sdk"
export ANDROID_SDK_ROOT="$ANDROID_HOME"
PATH_add "$ANDROID_HOME/cmdline-tools/latest/bin"
PATH_add "$ANDROID_HOME/platform-tools"
PATH_add "$ANDROID_HOME/emulator"
PATH_add "$HOME/.maestro/bin"
# Android Gradle needs JDK 21 (system default is Java 25):
export JAVA_HOME="$HOME/.sdkman/candidates/java/21.0.12-tem"
