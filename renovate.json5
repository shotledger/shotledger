// Extends the shared @skillsgateway preset (public repo, works from here);
// only repository-specific rules belong in this file. The preset's labels
// (bot-renovate*, renovate-version-*, security) exist on this repo — see
// docs/release.md "Repo configuration".
{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',

  extends: ['github>skillsgateway/.github//.github/renovate.json5'],

  addLabels: ['dependencies'],

  packageRules: [
    {
      // One CI run a week instead of one per package. Security fixes ignore
      // the schedule; majors stay separate PRs. Before the Expo rule so its
      // `enabled: false` still wins.
      description: 'Batch automerged updates weekly',
      matchUpdateTypes: ['minor', 'patch', 'pin'],
      groupName: 'non-major dependencies',
      schedule: ['before 6am on monday'],
    },
    {
      // Expo SDK, React Native, and React versions are tightly coupled;
      // Renovate must not bump them independently. Upgrades happen
      // deliberately via `npx expo install --fix` on a dedicated branch.
      description: 'Expo/RN core moves together, manually',
      groupName: 'expo core (manual)',
      matchPackageNames: [
        'expo{/,}**',
        // SDK-versioned packages outside the `expo` name (#902 bumped them
        // to v58 alone).
        '@expo/**',
        'jest-expo',
        'react-native{/,}**',
        'react',
        'react-dom',
        // Native modules the SDK pins too (`expo doctor` flags a drift).
        '@react-native-community/datetimepicker',
        '@react-native-community/slider',
      ],
      enabled: false,
    },
    {
      // `.node-version` is the source (#778); package.json `engines` and the
      // eas.json pin below must move with it in the same PR, or
      // `pnpm node:check` fails. Last, so it wins over the weekly batch name.
      description: 'Node moves in one PR across every pin',
      matchDepNames: ['node'],
      groupName: 'node',
    },
  ],

  customManagers: [
    {
      // EAS cannot read `.node-version`; app/eas.json repeats it.
      customType: 'regex',
      description: 'Node pin in the EAS base build profile',
      managerFilePatterns: ['/^app/eas\\.json$/'],
      matchStrings: ['"node":\\s*"(?<currentValue>[^"]+)"'],
      depNameTemplate: 'node',
      datasourceTemplate: 'node-version',
    },
  ],
}
